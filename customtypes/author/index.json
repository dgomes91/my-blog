{
  "id": "author",
  "label": "Author",
  "repeatable": true,
  "status": true,
  "format": "custom",
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "name": {
        "type": "Text",
        "config": {
          "label": "Name"
        }
      },
      "role": {
        "type": "Text",
        "config": {
          "label": "Role"
        }
      },
      "avatar": {
        "type": "Image",
        "config": {
          "label": "Avatar"
        }
      },
      "bio": {
        "type": "StructuredText",
        "config": {
          "label": "Bio",
          "single": "paragraph,strong,em,hyperlink"
        }
      },
      "focus_tags": {
        "type": "Group",
        "config": {
          "label": "Focus Tags",
          "fields": {
            "tag": {
              "type": "Text",
              "config": {
                "label": "Tag"
              }
            }
          }
        }
      },
      "social_links": {
        "type": "Group",
        "config": {
          "label": "Social Links",
          "fields": {
            "platform": {
              "type": "Select",
              "config": {
                "label": "Platform",
                "options": [
                  "X (Twitter)",
                  "Instagram",
                  "YouTube",
                  "Twitch",
                  "LinkedIn",
                  "Site Pessoal"
                ]
              }
            },
            "url": {
              "type": "Link",
              "config": {
                "label": "Url"
              }
            }
          }
        }
      },
      "email": {
        "type": "Text",
        "config": {
          "label": "Email"
        }
      },
      "is_founder": {
        "type": "Boolean",
        "config": {
          "label": "Is Founder",
          "default_value": true
        }
      },
      "active": {
        "type": "Boolean",
        "config": {
          "label": "Active",
          "default_value": true
        }
      }
    }
  }
}