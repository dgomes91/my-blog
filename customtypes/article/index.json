{
  "id": "article",
  "label": "Article",
  "repeatable": true,
  "status": true,
  "format": "page",
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {}
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Title"
        }
      },
      "excerpt": {
        "type": "Text",
        "config": {
          "label": "Excerpt"
        }
      },
      "format": {
        "type": "Select",
        "config": {
          "label": "Format",
          "default_value": "Notícia",
          "options": [
            "Notícia",
            "Review",
            "Lista TOP"
          ]
        }
      },
      "cover_image": {
        "type": "Image",
        "config": {
          "label": "Cover Image"
        }
      },
      "author": {
        "type": "Link",
        "config": {
          "label": "Author",
          "select": "document",
          "customtypes": [
            {
              "id": "author",
              "fields": [
                "name",
                "avatar",
                "role"
              ]
            }
          ]
        }
      },
      "tags": {
        "type": "Group",
        "config": {
          "label": "Tags",
          "fields": {
            "tag": {
              "type": "Text",
              "config": {
                "label": "Tag"
              }
            }
          }
        }
      },
      "breaking": {
        "type": "Boolean",
        "config": {
          "label": "Breaking",
          "default_value": true
        }
      },
      "is_preview": {
        "type": "Boolean",
        "config": {
          "label": "Is Preview",
          "default_value": true
        }
      },
      "featured": {
        "type": "Boolean",
        "config": {
          "label": "Featured",
          "default_value": true
        }
      },
      "reading_minutes": {
        "type": "Number",
        "config": {
          "label": "Reading Minutes"
        }
      },
      "review_score": {
        "type": "Number",
        "config": {
          "label": "Review Score"
        }
      },
      "review_copy_disclosure": {
        "type": "Text",
        "config": {
          "label": "Review Copy Disclosure"
        }
      },
      "early_access": {
        "type": "Boolean",
        "config": {
          "label": "Early Access",
          "default_value": true
        }
      },
      "score_revision_note": {
        "type": "StructuredText",
        "config": {
          "label": "Score Revision Note",
          "single": "paragraph,strong,em"
        }
      },
      "list_type": {
        "type": "Select",
        "config": {
          "label": "List Type",
          "options": [
            "Tier List",
            "Top N",
            "Recomendação"
          ]
        }
      },
      "list_item_count": {
        "type": "Number",
        "config": {
          "label": "List Item Count"
        }
      },
      "publish_date_override": {
        "type": "Date",
        "config": {
          "label": "Publish Date Override"
        }
      },
      "seo_title": {
        "type": "Text",
        "config": {
          "label": "Seo Title"
        }
      },
      "seo_description": {
        "type": "Text",
        "config": {
          "label": "Seo Description"
        }
      },
      "seo_image": {
        "type": "Image",
        "config": {
          "label": "Seo Image"
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    }
  }
}