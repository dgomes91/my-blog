  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "slices": {
        "config": {
          "choices": {
            "newsletter_cta": {
              "type": "SharedSlice"
            },
            "callout": {
              "type": "SharedSlice"
            },
            "comparison_table": {
              "type": "SharedSlice"
            },
            "gallery": {
              "type": "SharedSlice"
            },
            "image_block": {
              "type": "SharedSlice"
            },
            "pros_cons": {
              "type": "SharedSlice"
            },
            "pull_quote": {
              "type": "SharedSlice"
            },
            "ranking_list": {
              "type": "SharedSlice"
            },
            "related_articles": {
              "type": "SharedSlice"
            },
            "rich_text": {
              "type": "SharedSlice"
            },
            "video_embed": {
              "type": "SharedSlice"
            }
          }
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      },
      "title": {
        "config": {
          "label": "Title"
        },
        "type": "Text"
      },
      "excerpt": {
        "config": {
          "label": "Excerpt"
        },
        "type": "Text"
      },
      "format": {
        "config": {
          "default_value": "Notícia",
          "label": "Format",
          "options": [
            "Notícia",
            "Review",
            "Lista TOP"
          ]
        },
        "type": "Select"
      },
      "cover_image": {
        "config": {
          "label": "Cover Image"
        },
        "type": "Image"
      },
      "author": {
        "config": {
          "customtypes": [
            {
              "fields": [
                "name",
                "avatar",
                "role"
              ],
              "id": "author"
            }
          ],
          "label": "Author",
          "select": "document"
        },
        "type": "Link"
      },
      "tags": {
        "config": {
          "fields": {
            "tag": {
              "config": {
                "label": "Tag"
              },
              "type": "Text"
            }
          },
          "label": "Tags"
        },
        "type": "Group"
      },
      "breaking": {
        "config": {
          "default_value": false,
          "label": "Breaking"
        },
        "type": "Boolean"
      },
      "is_preview": {
        "config": {
          "default_value": false,
          "label": "Is Preview"
        },
        "type": "Boolean"
      },
      "featured": {
        "config": {
          "default_value": false,
          "label": "Featured"
        },
        "type": "Boolean"
      },
      "reading_minutes": {
        "config": {
          "label": "Reading Minutes"
        },
        "type": "Number"
      },
      "review_score": {
        "config": {
          "label": "Review Score"
        },
        "type": "Number"
      },
      "review_copy_disclosure": {
        "config": {
          "label": "Review Copy Disclosure"
        },
        "type": "Text"
      },
      "early_access": {
        "config": {
          "default_value": false,
          "label": "Early Access"
        },
        "type": "Boolean"
      },
      "score_revision_note": {
        "config": {
          "label": "Score Revision Note",
          "single": "paragraph,strong,em"
        },
        "type": "StructuredText"
      },
      "list_type": {
        "config": {
          "label": "List Type",
          "options": [
            "Tier List",
            "Top N",
            "Recomendação"
          ]
        },
        "type": "Select"
      },
      "list_item_count": {
        "config": {
          "label": "List Item Count"
        },
        "type": "Number"
      },
      "publish_date_override": {
        "config": {
          "label": "Publish Date Override"
        },
        "type": "Date"
      },
      "seo_title": {
        "config": {
          "label": "Seo Title"
        },
        "type": "Text"
      },
      "seo_description": {
        "config": {
          "label": "Seo Description"
        },
        "type": "Text"
      },
      "seo_image": {
        "config": {
          "label": "Seo Image"
        },
        "type": "Image"
      },
      "game": {
        "config": {
          "customtypes": [
            {
              "fields": [
                "title",
                "cover_image",
                {
                  "fields": [
                    "platform"
                  ],
                  "id": "platforms"
                }
              ],
              "id": "game"
            }
          ],
          "label": "Game",
          "select": "document"
        },
        "type": "Link"
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  },
  "label": "Article",
  "repeatable": true,
  "status": true
}